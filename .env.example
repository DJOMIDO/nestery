# Copy to .env.local and fill in the values.

# Postgres connection string. For Neon, use the *pooled* connection string
# (Neon console → Connect → "Pooled connection"). Example:
# postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Better Auth: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Public base URL of the app
BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth (optional). Callback URL: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth (optional). Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Assistant (optional). Users add their own API key in Settings > Assistant;
# it is stored encrypted with this key (generate with `openssl rand -base64 32`).
# Changing it makes saved keys unreadable, so users would have to add them again.
ASSISTANT_ENCRYPTION_KEY=
# Your own Anthropic key, used only for the emails below (comma-separated) when
# they haven't added a key of their own, limited per day
ANTHROPIC_API_KEY=
ASSISTANT_OWNER_EMAILS=
ASSISTANT_DAILY_LIMIT=50
# Model for the owner's key until one is chosen in Settings
ASSISTANT_DEFAULT_MODEL=claude-opus-5-5
